# Copy to .env and fill in. .env is gitignored; nix-shell loads it automatically.
# No quotes needed. Empty values are skipped, so an existing export isn't overwritten.

# GitHub personal access token (public_repo read is enough).
# Used by the crawler, the classifiers and toolkit.src.scan_api.
GITHUB_TOKEN=

# Only needed for crawler/src/repoClassifierGPT.py.
OPENAI_API_KEY=
